# FlowSync Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ==============================================
# SERVER CONFIGURATION
# ==============================================

NODE_ENV=production
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=https://flowsync.app

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@hostname:5432/flowsync

# Connection pool settings
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=5

# ==============================================
# REDIS CONFIGURATION
# ==============================================

# Redis connection string
REDIS_URL=redis://hostname:6379

# Redis password (if required)
REDIS_PASSWORD=your_redis_password_here

# ==============================================
# SECURITY & AUTHENTICATION
# ==============================================

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long

# Session Secret (generate with: openssl rand -base64 64)
SESSION_SECRET=your_session_secret_here_minimum_32_characters_long

# Encryption Key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_encryption_key_here_64_hex_characters

# API Key for protected endpoints (optional)
API_KEY=your_api_key_here

# ==============================================
# OPENAI CONFIGURATION
# ==============================================

# OpenAI API Key for AI features
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (default: gpt-4)
OPENAI_MODEL=gpt-4

# ==============================================
# ERROR TRACKING & MONITORING
# ==============================================

# Sentry DSN for backend error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry Environment
SENTRY_ENVIRONMENT=production

# Sentry Release (optional, set by CI/CD)
# SENTRY_RELEASE=flowsync@1.0.0

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level: error, warn, info, http, debug
LOG_LEVEL=info

# Enable file logging (logs to logs/ directory)
ENABLE_FILE_LOGGING=true

# Logs directory path
LOGS_DIR=/var/log/flowsync

# Slow request threshold in milliseconds
SLOW_REQUEST_THRESHOLD_MS=5000

# ==============================================
# EMAIL CONFIGURATION (Future)
# ==============================================

# Email service provider
# EMAIL_PROVIDER=sendgrid

# SendGrid API Key
# SENDGRID_API_KEY=your_sendgrid_api_key

# From email address
# EMAIL_FROM=noreply@flowsync.app

# ==============================================
# STORAGE CONFIGURATION (Future)
# ==============================================

# File storage provider: local, s3
# STORAGE_PROVIDER=s3

# AWS S3 Configuration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=flowsync-uploads
# AWS_S3_REGION=us-east-1

# ==============================================
# RATE LIMITING
# ==============================================

# Use Redis for distributed rate limiting
ENABLE_REDIS_RATE_LIMIT=true

# ==============================================
# FEATURE FLAGS
# ==============================================

# Enable AI features
ENABLE_AI_FEATURES=true

# Enable notifications
ENABLE_NOTIFICATIONS=true

# Enable exports
ENABLE_EXPORTS=true

# ==============================================
# CORS CONFIGURATION
# ==============================================

# Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://app.flowsync.com,https://www.flowsync.com

# ==============================================
# SSL/TLS CONFIGURATION
# ==============================================

# Force HTTPS redirect
FORCE_HTTPS=true

# HSTS Max Age (1 year in seconds)
HSTS_MAX_AGE=31536000

# ==============================================
# PERFORMANCE
# ==============================================

# Enable compression
ENABLE_COMPRESSION=true

# Request body size limits
MAX_REQUEST_SIZE=10mb

# ==============================================
# MISC
# ==============================================

# Application version (set by CI/CD)
# APP_VERSION=1.0.0

# Build timestamp (set by CI/CD)
# BUILD_TIMESTAMP=2025-11-15T00:00:00Z
