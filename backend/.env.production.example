# Production Environment Variables Template
# Copy this to .env.production and fill in real values

# Server Configuration
NODE_ENV=production
PORT=3001

# Database (Use managed PostgreSQL service)
DATABASE_URL=postgresql://user:password@production-host:5432/flowsync

# Redis (Use managed Redis service like Upstash or Railway)
REDIS_URL=redis://production-host:6379

# JWT (REQUIRED: Generate a strong secret - min 32 characters)
JWT_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-32-CHARS
JWT_EXPIRES_IN=7d

# AI Services (REQUIRED for AI features)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Music Services (Optional but recommended)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SUNO_API_KEY=your-suno-api-key

# Frontend URL (REQUIRED: Your production frontend URL)
FRONTEND_URL=https://your-domain.com

# Error Tracking (Optional: Sentry)
SENTRY_DSN=https://...@sentry.io/...

# Analytics (Optional)
ANALYTICS_ID=

# Logging Level
LOG_LEVEL=info

# Rate Limiting (Optional: adjust based on your needs)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
